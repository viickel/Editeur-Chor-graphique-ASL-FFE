/* Fond global clair et propre */
QMainWindow, QDialog {
    background-color: #f5f5f5;
    color: #222222;
}

/* Groupes stylés avec bordure douce */
QGroupBox {
    font-weight: bold;
    border: 1px solid #cccccc;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 10px;
    color: #000000;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #005f87; /* Bleu Laser adapté pour le clair */
}

/* Boutons avec une touche de profondeur légère */
QPushButton {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #4a90d9;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #e3f2fd;
    border: 1px solid #1976d2;
    color: #000000;
}

/* Boutons spéciaux type "Laser" (version claire) */
QPushButton[success="true"] { background-color: #c8e6c9; border-color: #2e7d32; color: #000000; }
QPushButton[danger="true"] { background-color: #ffcdd2; border-color: #c62828; color: #000000; }
QPushButton[secondary="true"] { background-color: #cfd8dc; border-color: #546e7a; color: #000000; }

/* Saisie de texte */
QLineEdit, QTextEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #bbbbbb;
    color: #000000;
    padding: 4px;
    border-radius: 3px;
}

/* Tableaux et Listes */
QTableWidget, QListWidget {
    background-color: #ffffff;
    alternate-background-color: #f0f0f0;
    border: 1px solid #cccccc;
    gridline-color: #cccccc;
}
QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #4a90d9;
    color: white;
}
QHeaderView::section {
    background-color: #e0e0e0;
    color: #333333;
    padding: 4px;
    border: 1px solid #cccccc;
}

/* Tabs */
QTabBar::tab {
    background-color: #e0e0e0;
    color: #555555;
    padding: 6px 14px;
    border: 1px solid #cccccc;
}
QTabBar::tab:selected {
    background-color: #f5f5f5;
    color: #005f87;
    border-bottom: none;
}